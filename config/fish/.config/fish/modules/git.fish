
# Git command abbriviation
abbr -a g git

# Git sub-command abbriviations
abbr -c git st "status"

abbr -c git c "commit"
abbr -c git cm "commit -m"

abbr -c git a "add"
abbr -c git aa "add ."

abbr -c git co "checkout"

abbr -c git b "branch"

abbr -c git s "switch"

abbr -c git d "diff"

abbr -c git p "push"
abbr -c git u "pull --rebase"

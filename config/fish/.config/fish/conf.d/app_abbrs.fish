
if status is-interactive 

    # Git Abbriviations 
    abbr -a -c git a  "add"
    abbr -a -c git d  "diff"
    abbr -a -c git p  "push"
    abbr -a -c git u  "pull"
    abbr -a -c git cm "commit -m"
    abbr -a -c git ca "commit -a"
    abbr -a -c git aa "add ."
    abbr -a -c git ap "add --patch"
    abbr -a -c git cl "clone"

    # Cargo Abbriviations
    abbr -a -c cargo r  "run"
    abbr -a -c cargo b  "build"
    abbr -a -c cargo br "build --release"
end

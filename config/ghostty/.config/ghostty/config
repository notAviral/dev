# -------------------------------------------------------------
# Appearance :
# -------------------------------------------------------------

# Theme 
# theme                   = "colors_wallust.conf"
theme                   = "TokyoNight Night"

# Fonts : 
font-family             = FiraCode Nerd Font Mono
font-family-bold        = FiraCode Nerd Font Mono Bold
font-family-italic      = FiraCode Nerd Font Mono Italic
font-family-bold-italic = FiraCode Nerd Font Mono Bold Italic
font-size = 15

# Opacity and Blurness of the window : 
background-opacity      = 0.90
background-blur         = 80                        
# blur doesn't works in x11 with gnome but will work with hyprland

# BackGround and ForeGround Colors :
# (needs to be updated when using hyprland to get backgroud related Colors)
# backgroud               = RRGGBB
# foreground              = RRGGBB 
# selection-background    = RRGGBB
# selection-foreground    = RRGGBB

# Cursor :  
# (needs to be updated when using hyprland to get backgroud related Colors)
# cursor-color            = RRGGBB
# cursor-opacity          = RRGGBB
cursor-style            = block 
cursor-style-blink      = true 
scroll-to-bottom        = keystroke



# KeyBinds : 
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+space=toggle_readonly

# Window decorations :
window-decoration       = none
gtk-titlebar            = false

# Import shaders : 
custom-shader = ./shaders/cursor_smear.glsl

[alias]
    lg = log \
        --graph \
        --all \
        --decorate \
        --abbrev-commit \
        --date=format:'%Y-%m-%d %H:%M' \
        --pretty=format:'%C(auto)%h %C(yellow)%d%Creset%n│ %C(white)%s%Creset%n│ Author : %C(Cyan)%an%Creset <%C(green)%ae%Creset>%n│ Date : %C(green)%ad%Creset%n%n'

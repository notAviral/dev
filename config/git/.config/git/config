# User Configs :

# this is to upload my git config to GitHub without
# worrying about my personal stuff
[include]
  path = "~/.config/git/modules/config_personal"

# Machine Config :
[core]
  compression = 9
  editor = nvim
  preloadindex = true

# Commit Template :
[commit]
  template = "~/.config/git/modules/git_commit_template.txt"
    gpgsign = true

# Personal Preferences :
[init]
  defaultBranch = main

# Functionality configs :
[include]
  path = "~/.config/git/modules/opts_config"
    path = "~/.config/git/modules/aliases"

# User Configs :

# this is to upload my git config to GitHub without
# worrying about my personal stuff
[include]
  path = "./config_personal"

# Machine Config :
[core]
  compression = 9
  editor = nvim
  preloadindex = true

# Commit Template :
[commit]
  template = "~/.config/git/git_commit_template.txt"

# Personal Preferences :
[init]
  defaultBranch = main

# Functionality configs :
[include]
  path = "./opts_config"
